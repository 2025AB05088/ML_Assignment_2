# Base image optimized for production inference
FROM python:3.9-slim

# Set the working directory inside the container
WORKDIR /app

# Prevent Python from writing pyc files to disc and buffering stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install required system dependencies (if any are needed for ML libraries)
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the application code and serialized models
COPY . .

# Expose the default Streamlit port
EXPOSE 8501

# Enterprise QA: Add a healthcheck to ensure the container is serving traffic
HEALTHCHECK CMD curl --fail http://localhost:8501/_stcore/health || exit 1

# Command to initialize the Streamlit QA dashboard
CMD ["streamlit", "run", "streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
